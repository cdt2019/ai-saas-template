{
  "name": "ai-saas-template",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Next.js template for AI SaaS: auth, credits, Stripe / Creem / Waffo payments, AI text, image and video, and a full admin console.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdt2019/ai-saas-template.git"
  },
  "keywords": [
    "nextjs",
    "saas",
    "saas-template",
    "ai",
    "stripe",
    "better-auth",
    "drizzle",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@floating-ui/react-dom": "^2.1.9",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@sentry/nextjs": "11.11.0",
    "@types/mdx": "^2.0.14",
    "@waffo/pancake-ts": "0.26.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.3",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.48.0",
    "next": "16.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "5.1.0"
  }
}
