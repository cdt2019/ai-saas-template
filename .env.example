# 复制为 .env.local（本地）或在 Vercel / Cloudflare 后台配置
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_GA_ID=

# ---------- 数据库 ----------
# 不填：本地自动使用 PGlite（.data/pglite），零配置
# 线上：Neon / Supabase 的连接串，上线前执行 npm run db:migrate
# 运行时一定用「连接池」地址：Neon 主机名带 -pooler，Supabase 用 pooler.supabase.com:6543
# 直连地址只给迁移用，填在 DATABASE_URL_UNPOOLED（Neon 的 Vercel 集成会自动配好这两个变量）
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 每个服务实例的最大连接数（默认 5）
DB_POOL_MAX=

# ---------- 登录（Better Auth） ----------
# 生成：npx @better-auth/cli secret 或 openssl rand -base64 32（生产必填）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.example.com
# 邮箱注册要输入 6 位验证码才能登录（默认开启，线上必须配 Resend 才发得出验证码）；填 false 关闭
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# 新用户注册赠送的积分（开启邮箱验证时，验证通过才发）；用户多为一次性访问的站点建议设为 0（不给免费额度）
SIGNUP_BONUS_CREDITS=10
# Google：console.cloud.google.com → 凭据 → OAuth 客户端，回调地址 https://你的域名/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub：github.com/settings/developers，回调地址 https://你的域名/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- 邮件（Resend） ----------
# resend.com 注册 → Domains 添加并验证你的域名（按提示加 DNS 记录）→ API Keys 创建；免费版每月 3000 封、每天 100 封
# 不填：邮件内容打印在终端里（本地测试时验证码从终端复制即可）
RESEND_API_KEY=
EMAIL_FROM="YourBrand <hello@example.com>"

# ---------- 支付 ----------
# stripe | creem | waffo | mock（本地默认 mock，生产必须选 stripe、creem 或 waffo）
PAYMENT_PROVIDER=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
# Creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_PRODUCT_STARTER=
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_MAX=
# Waffo Pancake（MoR）：控制台 API 与开发 →「创建 API 密钥」区域
#   商户 ID：密钥列表上方第一行的复制按钮（不是店铺 ID）；测试、生产各建一把 API Key，私钥换行写成 \n
#   测试卡 4576 7500 0000 0110 成功、4576 7500 0000 0220 拒绝
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# 或者：整段 PEM 的 base64（cat private.pem | base64 | tr -d '\n'），适合 CI
WAFFO_PRIVATE_KEY_BASE64=
# true：webhook 只处理测试事件；上线换生产 key 时改成 false
WAFFO_TEST_MODE=true
# 产品 ID：控制台 产品 → 点开产品，URL 和详情页里能看到（PROD_xxx）
WAFFO_PRODUCT_STARTER=
WAFFO_PRODUCT_PRO=
WAFFO_PRODUCT_MAX=
# 必填：店铺 ID（设置 → 店铺资料）。webhook 只接受这个店铺的事件——Waffo 全平台共用签名密钥，
# 不校验店铺的话，别人在自己店铺里把回调地址填成你的，就能伪造充值。也用于用户中心的「管理订阅」
WAFFO_STORE_ID=
# 定时任务（查漏单、每日对账、账务检查、清理）的调用密钥：openssl rand -hex 32。
# 外部定时调用 /api/cron/tick 时带 Authorization: Bearer <CRON_SECRET>；Vercel 上设了它，vercel.json 里的 Cron 会自动带上
CRON_SECRET=
# 定时任务的「时钟」：不填 = 外部调用 /api/cron/tick（Vercel Cron / GitHub Actions / crontab）；
# internal = 服务启动时开进程内定时器（next start 常驻的服务器、Docker 用这个，不需要外部定时服务）
CRON_MODE=
# 预期多少分钟被触发一次（后台据此判断「时钟停了」）：默认 internal 为 1，外部调用为 1440（每天）
CRON_TICK_MINUTES=
# 余额跌破多少提醒用户充值（站内通知），默认 5；0 关闭
LOW_CREDITS_THRESHOLD=
# 调支付平台接口的超时（毫秒），默认 15000
PAYMENT_HTTP_TIMEOUT_MS=

# ---------- AI ----------
# 文本：OpenAI 兼容接口，默认 OpenRouter（一个 key 可用 Claude / GPT / Gemini / DeepSeek 等）
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TEXT_MODEL=anthropic/claude-haiku-4.5
# 图片、视频：fal.ai（不填 FAL_KEY：本地用 mock，视频 8 秒后返回 public/mock/sample-video.mp4）
FAL_KEY=
AI_IMAGE_MODEL=fal-ai/flux/schnell
# 图生视频模型；换模型时到 fal 模型页的 API 文档核对输入字段，时长、清晰度在 src/config/ai.ts 的 extraInput 里改
# 线上配置了 https 的 NEXT_PUBLIC_SITE_URL 时，生成完成会回调 /api/webhooks/fal，用户关掉页面也能收到完成邮件
AI_VIDEO_MODEL=bytedance/seedance-2.5/us/image-to-video

# ---------- 防刷 ----------
# Cloudflare Turnstile（dash.cloudflare.com → Turnstile → 添加站点，免费）；两个都填才启用
# 启用后注册、登录、发验证码、找回密码都要过人机验证
# 本地测试可用官方测试密钥：站点密钥 1x00000000000000000000AA，秘密密钥 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 限流阈值（不填用默认值，见 src/lib/abuse.ts）
LIMIT_SIGNUP_PER_IP_HOUR=
LIMIT_SIGNIN_PER_IP_10MIN=
LIMIT_OTP_PER_IP_10MIN=
LIMIT_AI_PER_USER_MIN=
LIMIT_AI_PER_IP_MIN=
LIMIT_UPLOADS_PER_USER_HOUR=

# ---------- 管理员 ----------
# 这些邮箱在「邮箱已验证」时成为管理员，可访问 /admin：用 Google / GitHub 登录，或用邮箱注册并输入验证码
# 只看邮箱不看验证的话，别人抢先用你的邮箱注册就能拿到后台。也可以直接在数据库里把 role 改成 admin
# 支付定时任务发现问题（回调丢了、处理出错等）时也发邮件到这些地址
ADMIN_EMAILS=

# ---------- 文件存储（Cloudflare R2） ----------
# 不填：本地开发存到 .data/uploads
# 桶需要配置 CORS：允许你的域名 PUT，AllowedHeaders 包含 Content-Type
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://files.example.com

# 错误监控 Sentry（可选）：不填就完全不加载。服务端和浏览器各一个 DSN，可以填同一个
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# 环境名，默认用 NODE_ENV
SENTRY_ENVIRONMENT=
# 性能追踪采样率（0–1），默认 0：只报错误
SENTRY_TRACES_SAMPLE_RATE=
# 构建时上传 source map（错误堆栈能看到源码），三个都填才生效
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Newsletter：定时任务每次最多发多少封，默认 100
NEWSLETTER_BATCH_SIZE=
# 同一 IP 每小时最多提交几次订阅，默认 5
LIMIT_NEWSLETTER_PER_IP_HOUR=

# 只用于在本机用 PGlite 试跑 next start；线上不要设置
ALLOW_PGLITE=
